# Copy the names below into your host's "Environment" settings (Render) with your real values.
# Never commit real values to Git.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
JWT_SECRET=<a long random string>
CORS_ORIGINS=http://localhost:3000,https://smart-finance-assistant.vercel.app,https://smart-finance-assistant-*-devisri4s-projects.vercel.app

# AI assistant (optional: without a key the rest of the app still works).
# Get a free key at https://console.groq.com/keys
AI_API_KEY=<your Groq API key>
# Optional overrides to switch provider or model (defaults shown):
AI_BASE_URL=https://api.groq.com/openai
AI_MODEL=openai/gpt-oss-20b
# Optional: how many assistant messages the whole site may send per day (default 50, fits Groq's free quota).
AI_DAILY_LIMIT=50
